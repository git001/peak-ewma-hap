# =============================================================================
# Multi-stage build for h2load with HTTP/3 (QUIC) support
# TLS backend: aws-lc (BoringSSL-compatible)
# Components: aws-lc -> nghttp3 -> ngtcp2 -> nghttp2 (h2load)
#
# Based on server-benchmark/containers/loadgen/h2load, with current versions,
# a bounded build parallelism (JOBS) and curl + socat for the bench script.
# =============================================================================

ARG ALPINE_VERSION=3.23

# -----------------------------------------------------------------------------
# Stage 1: Build all dependencies and h2load
# -----------------------------------------------------------------------------
FROM docker.io/alpine:${ALPINE_VERSION} AS builder

ARG AWS_LC_VERSION=v5.12.0
ARG NGHTTP3_VERSION=1.18.0
ARG NGTCP2_VERSION=1.25.0
ARG NGHTTP2_VERSION=1.70.0
ARG JOBS=4

RUN apk add --no-cache \
    ca-certificates \
    curl \
    xz \
    git \
    cmake \
    make \
    gcc \
    g++ \
    autoconf \
    automake \
    libtool \
    pkgconf \
    libev-dev \
    c-ares-dev \
    zlib-dev \
    linux-headers \
    perl

WORKDIR /build

# ---- Build aws-lc ----
RUN git clone --depth 1 -b ${AWS_LC_VERSION} https://github.com/aws/aws-lc && \
    cd aws-lc && \
    cmake -B build \
      -DDISABLE_GO=ON \
      -DBUILD_SHARED_LIBS=OFF \
      -DCMAKE_BUILD_TYPE=Release \
      --install-prefix=/build/aws-lc/opt && \
    make -j${JOBS} -C build && \
    cmake --install build

# ---- Build nghttp3 ----
RUN curl -fsSL https://github.com/ngtcp2/nghttp3/releases/download/v${NGHTTP3_VERSION}/nghttp3-${NGHTTP3_VERSION}.tar.xz | \
    tar -xJ && \
    cd nghttp3-${NGHTTP3_VERSION} && \
    autoreconf -i && \
    ./configure \
      --prefix=/build/nghttp3-${NGHTTP3_VERSION}/build \
      --enable-lib-only && \
    make -j${JOBS} && \
    make install

# ---- Build ngtcp2 (with aws-lc / boringssl crypto backend) ----
RUN curl -fsSL https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.xz | \
    tar -xJ && \
    cd ngtcp2-${NGTCP2_VERSION} && \
    autoreconf -i && \
    ./configure \
      --prefix=/build/ngtcp2-${NGTCP2_VERSION}/build \
      --enable-lib-only \
      --with-boringssl \
      BORINGSSL_CFLAGS="-I/build/aws-lc/opt/include" \
      BORINGSSL_LIBS="-L/build/aws-lc/opt/lib -lssl -lcrypto" \
      PKG_CONFIG_PATH="/build/aws-lc/opt/lib/pkgconfig" && \
    make -j${JOBS} && \
    make install

# ---- Build nghttp2 (h2load + nghttpx with HTTP/3) ----
RUN curl -fsSL https://github.com/nghttp2/nghttp2/releases/download/v${NGHTTP2_VERSION}/nghttp2-${NGHTTP2_VERSION}.tar.xz | \
    tar -xJ && \
    cd nghttp2-${NGHTTP2_VERSION} && \
    autoreconf -i && \
    ./configure \
      --prefix=/opt/nghttp2 \
      --enable-http3 \
      --enable-app \
      --disable-python-bindings \
      PKG_CONFIG_PATH="/build/aws-lc/opt/lib/pkgconfig:/build/nghttp3-${NGHTTP3_VERSION}/build/lib/pkgconfig:/build/ngtcp2-${NGTCP2_VERSION}/build/lib/pkgconfig" \
      LDFLAGS="-Wl,-rpath,/opt/nghttp2/lib" && \
    make -j${JOBS} && \
    make install

# -----------------------------------------------------------------------------
# Stage 2: Minimal runtime image
# -----------------------------------------------------------------------------
FROM docker.io/alpine:${ALPINE_VERSION}

RUN apk add --no-cache \
    libev \
    c-ares \
    zlib \
    libstdc++ \
    ca-certificates \
    curl \
    socat

# Copy the nghttp2 installation
COPY --from=builder /opt/nghttp2 /opt/nghttp2

# Copy dependency libs
COPY --from=builder /build/aws-lc/opt/lib /opt/aws-lc/lib
COPY --from=builder /build/nghttp3-*/build/lib /opt/nghttp3/lib
COPY --from=builder /build/ngtcp2-*/build/lib /opt/ngtcp2/lib

# Set library paths
ENV LD_LIBRARY_PATH="/opt/nghttp2/lib:/opt/aws-lc/lib:/opt/nghttp3/lib:/opt/ngtcp2/lib"
ENV PATH="/opt/nghttp2/bin:${PATH}"

# Verify the build
RUN h2load --version

ENTRYPOINT ["h2load"]