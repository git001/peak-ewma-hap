# =============================================================================
# gRPC service of the peak EWMA test bed: Spring Boot with its gRPC server
# (Netty, h2c on 9090), see src/main/java/at/none/work/WorkService.java
#
# Build:
#   podman build -f grpc/service/Containerfile -t peak-ewma-grpc-svc grpc/service
#
# Environment:
#   JAVA_OPTS   options of the JVM, the same for all services
#               (default: 256 MiB heap, Parallel GC, GC log on stdout)
#   RETAIN_MB   cache of long-lived entries replaced by the calls  100
#   SLOT_KB     size of one cache entry                            64
# =============================================================================
ARG MAVEN_IMAGE=docker.io/library/maven:3.9.11-eclipse-temurin-25
ARG JRE_IMAGE=docker.io/library/eclipse-temurin:25-jre-alpine

FROM ${MAVEN_IMAGE} AS builder

WORKDIR /build
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src/ src/
RUN mvn -B -q package -DskipTests

# -----------------------------------------------------------------------------
FROM ${JRE_IMAGE}

RUN adduser -D -H -u 1001 -G root work
COPY --from=builder /build/target/work.jar /opt/work/work.jar

ENV JAVA_OPTS="-Xms256m -Xmx256m -XX:+UseParallelGC -Xlog:gc:stdout:time,uptime"
USER 1001
EXPOSE 9090
# sh -c so that JAVA_OPTS is split into words
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /opt/work/work.jar"]
